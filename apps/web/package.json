{
  "name": "@kinsen/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "pnpm --filter @kinsen/budget-domain build",
