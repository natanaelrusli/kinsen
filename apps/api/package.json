{
  "name": "@kinsen/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/server.ts",
    "prebuild": "pnpm --filter @kinsen/budget-domain build",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env.local dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:transfer-owner": "node --env-file-if-exists=../../.env.local --import tsx src/db/transfer-owner.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@kinsen/budget-domain": "workspace:*",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
